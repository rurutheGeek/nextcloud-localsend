# Shared secret. Put the same value into the app's admin settings.
LOCALSEND_SEND_TOKEN=change-me

# Stable sender fingerprint. Generate once, e.g.:
#   openssl rand -hex 32
LOCALSEND_SEND_FINGERPRINT=change-me

# Sender name shown on the receiving device.
LOCALSEND_SEND_ALIAS=nextcloud

# Optional tuning.
#LOCALSEND_SEND_PORT=53200
#LOCALSEND_SEND_TIMEOUT=3
# CIDR probed outbound for devices (the multicast reply is often blocked by
# firewalls). Default: the local /24. Set to "none" to disable the scan.
#LOCALSEND_SEND_SCAN=192.168.1.0/24
#LOCALSEND_SEND_MAX_BYTES=2147483648

# Optional: receive files from LocalSend devices into Nextcloud.
# Receiving stays off until an administrator turns it on (with a PIN) under
# Administration settings -> LocalSend Share. The relay token above is used.
#LOCALSEND_RECEIVE_NEXTCLOUD_URL=https://cloud.example.net
# LocalSend apps look for receivers on port 53317; "none" disables this port.
#LOCALSEND_RECEIVE_PORT=53317
# Set to 1 only for a Nextcloud with a self-signed certificate.
#LOCALSEND_RECEIVE_INSECURE=0
